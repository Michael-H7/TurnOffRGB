{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: configure",
            "command": "configure",
            "preset": "windows",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build TurnOffRGB (Release)",
            "command": "build",
            "preset": "windows-release",
            "targets": ["TurnOffRGB"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["CMake: configure"],
            "problemMatcher": ["$msCompile"]
        },
        {
            "type": "cmake",
            "label": "Build TurnOffRGB (Debug)",
            "command": "build",
            "preset": "windows-debug",
            "targets": ["TurnOffRGB"],
            "group": "build",
            "dependsOn": ["CMake: configure"],
            "problemMatcher": ["$msCompile"]
        }
    ]
}
